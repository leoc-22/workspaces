#!/usr/bin/env bash

set -euo pipefail

DEFAULT_PROJECT_ROOT="$HOME/Developer"
DEFAULT_WINDOW_NAMES=(ai editor shell)
DEFAULT_YAML_LAYOUT_FILE=".tmux-workspaces/layout.yaml"
DEFAULT_YAML_LAYOUT_FILE_ALT=".tmux-workspaces/layout.yml"
GLOBAL_YAML_LAYOUTS_DIR="$HOME/.config/tmux-workspaces/layouts"

LAYOUT_NAME=""
LAYOUT_FILE_ARG=""
SESSION_MODE=0
POPUP_MODE=0
SESSION_NAME_ARG=""
TARGET_ARG=""
TARGET_PROVIDED=0

usage() {
  cat <<'EOF'
Usage: tmux-workspaces [options] [project-name-or-directory]

Options:
  -l, --layout <name>   Use ~/.config/tmux-workspaces/layouts/<name>.yaml (or .yml)
  -f, --file <path>     Use an explicit YAML layout file
  -s, --session [name]  Fuzzy-pick an active tmux session, or switch to name
  --popup              Fill an existing tmux popup without an inner border
  -h, --help            Show this help

Examples:
  tmux-workspaces
  tmux-workspaces my-app
  tmux-workspaces ../shared-lib
  tmux-workspaces --session
  tmux-workspaces --session my-app
  tmux-workspaces --layout dev
  tmux-workspaces --file ~/layouts/cow.yaml

Notes:
  - No args (interactive): opens an fzf picker for sessions and projects; cancel exits.
  - No args (non-interactive): uses current dir.
  - --session only switches to active tmux sessions; it does not create projects.
  - With --layout or --file and no target: uses session.dir from YAML when present, otherwise current dir.
  - Single target: YAML layout or default windows.
EOF
}

fail() {
  printf 'tmux-workspaces: %s\n' "$1" >&2
  exit 1
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s\n' "$value"
}

expand_path() {
  local raw_path="$1"

  case "$raw_path" in
    "~")
      printf '%s\n' "$HOME"
      ;;
    "~/"*)
      printf '%s/%s\n' "$HOME" "${raw_path#\~/}"
      ;;
    *)
      printf '%s\n' "$raw_path"
      ;;
  esac
}

canonical_file() {
  local path="$1"
  if [[ ! -f "$path" ]]; then
    fail "file not found: $path"
  fi
  printf '%s/%s\n' "$(cd "$(dirname "$path")" && pwd -P)" "$(basename "$path")"
}

normalize_name() {
  local value="$1"
  local normalized

  normalized="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' '-')"
  normalized="${normalized#-}"
  normalized="${normalized%-}"
  printf '%s\n' "$normalized"
}

set_target() {
  [[ "$TARGET_PROVIDED" -eq 0 ]] || fail "only one target is supported"
  [[ -n "$1" ]] || fail "target cannot be empty"
  TARGET_ARG="$1"
  TARGET_PROVIDED=1
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --popup)
        POPUP_MODE=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -l|--layout|-f|--file)
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || fail "missing value for $1"
        case "$1" in
          -l|--layout) LAYOUT_NAME="$2" ;;
          -f|--file) LAYOUT_FILE_ARG="$2" ;;
        esac
        shift 2
        ;;
      --layout=*)
        LAYOUT_NAME="${1#*=}"
        [[ -n "$LAYOUT_NAME" ]] || fail "missing value for --layout"
        shift
        ;;
      --file=*)
        LAYOUT_FILE_ARG="${1#*=}"
        [[ -n "$LAYOUT_FILE_ARG" ]] || fail "missing value for --file"
        shift
        ;;
      -s|--session)
        SESSION_MODE=1
        if [[ $# -ge 2 && "$2" != -* ]]; then
          SESSION_NAME_ARG="$2"
          [[ -n "$SESSION_NAME_ARG" ]] || fail "missing value for --session"
          shift 2
        else
          shift
        fi
        ;;
      --session=*)
        SESSION_MODE=1
        SESSION_NAME_ARG="${1#*=}"
        [[ -n "$SESSION_NAME_ARG" ]] || fail "missing value for --session"
        shift
        ;;
      --)
        shift
        while [[ $# -gt 0 ]]; do
          set_target "$1"
          shift
        done
        ;;
      -*) fail "unknown option: $1" ;;
      *)
        set_target "$1"
        shift
        ;;
    esac
  done

  if [[ -n "$LAYOUT_NAME" && -n "$LAYOUT_FILE_ARG" ]]; then
    fail "use either --layout <name> or --file <path>, not both"
  fi
  if [[ "$SESSION_MODE" -eq 1 ]]; then
    if [[ -n "$LAYOUT_NAME" || -n "$LAYOUT_FILE_ARG" ]]; then
      fail "--session cannot be combined with --layout or --file"
    fi
    [[ "$TARGET_PROVIDED" -eq 0 ]] || fail "--session accepts at most one session name"
  fi
  if [[ "$LAYOUT_NAME" == -* || "$LAYOUT_NAME" == */* ]]; then
    fail "--layout accepts a layout name only; use --file for paths"
  fi
}

resolve_target() {
  local input="$1"
  local zoxide_target

  if [[ -z "$input" ]]; then
    printf '%s\n' "$PWD"
    return
  fi

  case "$input" in
    /*|./*|../*|.|..|~|~/*)
      expand_path "$input"
      return
      ;;
  esac

  if [[ -d "$input" ]]; then
    printf '%s\n' "$input"
    return
  fi

  if command -v zoxide >/dev/null 2>&1; then
    zoxide_target="$(zoxide query -- "$input" 2>/dev/null || true)"
    if [[ -n "$zoxide_target" && -d "$zoxide_target" ]]; then
      printf '%s\n' "$zoxide_target"
      return
    fi
  fi

  printf '%s\n' "$DEFAULT_PROJECT_ROOT/$input"
}

collect_project_candidates() {
  local roots_raw
  local -a roots=()
  local root
  local dir

  if [[ -n "${PROJ_SEARCH_DIRS:-}" ]]; then
    roots_raw="$PROJ_SEARCH_DIRS"
  else
    roots_raw="$DEFAULT_PROJECT_ROOT"
  fi

  IFS=':' read -r -a roots <<<"$roots_raw"

  for root in "${roots[@]}"; do
    root="$(expand_path "$root")"

    if [[ ! -d "$root" ]]; then
      continue
    fi

    for dir in "$root"/*; do
      if [[ -d "$dir" ]]; then
        printf '%s\n' "$dir"
      fi
    done
  done
}

collect_tmux_sessions() {
  tmux list-sessions -F '#S' 2>/dev/null || true
}

collect_session_picker_candidates() {
  local session_name

  while IFS= read -r session_name; do
    if [[ -n "$session_name" ]]; then
      printf '\033[36m[session] %s\033[0m\n' "$session_name"
    fi
  done < <(collect_tmux_sessions)
}

collect_project_picker_candidates() {
  local project_dir

  while IFS= read -r project_dir; do
    if [[ -n "$project_dir" ]]; then
      printf '[project] %s\n' "$project_dir"
    fi
  done < <(collect_project_candidates)
}

run_fzf() {
  if [[ "$POPUP_MODE" -eq 1 ]]; then
    fzf "$@" --layout=reverse --no-height --border=none --margin=0 --padding=0
  else
    fzf "$@" --height=40% --layout=reverse --border
  fi
}

select_with_fzf() {
  local selection
  selection="$(
    {
      collect_session_picker_candidates
      collect_project_picker_candidates
    } | run_fzf --ansi --prompt='workspace> ' || true
  )"
  if [[ -n "$selection" ]]; then
    printf '%s\n' "$selection"
  fi
}

select_session_with_fzf() {
  local selection
  selection="$(collect_tmux_sessions | run_fzf --prompt='session> ' || true)"
  if [[ -n "$selection" ]]; then
    printf '%s\n' "$selection"
  fi
}

switch_to_session() {
  local session_name="$1"

  if [[ -z "$session_name" ]]; then
    fail "missing tmux session name"
  fi

  if ! tmux has-session -t "$session_name" 2>/dev/null; then
    fail "tmux session not found: $session_name"
  fi

  if [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "$session_name"
  fi

  exec tmux attach-session -t "$session_name"
}

run_window_command() {
  local tmux_target="$1"
  local command="$2"

  command="$(trim "$command")"
  if [[ -z "$command" ]]; then
    return
  fi

  tmux send-keys -t "$tmux_target" "$command" C-m
}

run_split_pane() {
  local window_target="$1"
  local window_dir="$2"
  local direction="$3"
  local command="$4"
  local split_flag
  local pane_id

  case "$direction" in
    h) split_flag="-v" ;;
    v) split_flag="-h" ;;
    *) fail "pane split must be h (top/bottom) or v (left/right)" ;;
  esac
  [[ -n "$command" ]] || return 0
  pane_id="$(tmux split-window "$split_flag" -d -P -F '#{pane_id}' -t "$window_target" -c "$window_dir")"
  run_window_command "$pane_id" "$command"
}

resolve_layout_dir() {
  local target_dir="$1"
  local raw_dir="$2"
  local candidate

  if [[ -z "$raw_dir" ]]; then
    raw_dir="."
  fi

  case "$raw_dir" in
    "~")
      candidate="$HOME"
      ;;
    "~/"*)
      candidate="$HOME/${raw_dir#\~/}"
      ;;
    /*)
      candidate="$raw_dir"
      ;;
    *)
      candidate="$target_dir/$raw_dir"
      ;;
  esac

  if [[ ! -d "$candidate" ]]; then
    fail "layout directory not found: $candidate"
  fi

  printf '%s\n' "$(cd "$candidate" && pwd -P)"
}

require_yq() {
  if ! command -v yq >/dev/null 2>&1; then
    fail "yq is required for YAML layouts"
  fi
}

validate_layout() {
  local layout_file="$1"
  local errors
  require_yq
  errors="$(yq e -r '[
    {"invalid": ((.windows | tag) != "!!seq" or (.windows | length) == 0), "message": "windows must be a nonempty list"},
    {"invalid": ([(.session, .windows[]) | select(tag == "!!map") | select(has("path"))] | length > 0), "message": "rename path to dir"},
    {"invalid": ([(.windows[], .windows[].panes[]?) | select(tag == "!!map") | select(has("run"))] | length > 0), "message": "rename run to command"},
    {"invalid": ([.windows[].panes[]? | select(tag != "!!map")] | length > 0), "message": "panes must be objects with command and optional split"},
    {"invalid": ([.windows[].panes[]? | select(tag == "!!map") | select((.split // "h") != "h" and (.split // "h") != "v")] | length > 0), "message": "pane split must be h (top/bottom) or v (left/right)"}
  ] | .[] | select(.invalid) | .message' "$layout_file")" || fail "invalid YAML layout: $layout_file"
  [[ -z "$errors" ]] || fail "invalid layout $layout_file:
$errors"
}

resolve_layout_file_arg() {
  local file_arg="$1"
  local candidate

  candidate="$(expand_path "$file_arg")"
  if [[ ! -f "$candidate" ]]; then
    fail "layout file not found: $file_arg"
  fi

  canonical_file "$candidate"
}

resolve_yaml_layout_file() {
  local target_dir="$1"
  local candidate
  local layouts_dir
  local layout_name

  if [[ -n "$LAYOUT_FILE_ARG" ]]; then
    resolve_layout_file_arg "$LAYOUT_FILE_ARG"
    return
  fi

  if [[ -n "$LAYOUT_NAME" ]]; then
    layouts_dir="$GLOBAL_YAML_LAYOUTS_DIR"
    layout_name="$LAYOUT_NAME"

    case "$layout_name" in
      *.yaml)
        layout_name="${layout_name%.yaml}"
        ;;
      *.yml)
        layout_name="${layout_name%.yml}"
        ;;
    esac

    candidate="$layouts_dir/$layout_name.yaml"
    if [[ -f "$candidate" ]]; then
      canonical_file "$candidate"
      return
    fi

    candidate="$layouts_dir/$layout_name.yml"
    if [[ -f "$candidate" ]]; then
      canonical_file "$candidate"
      return
    fi

    fail "layout '$LAYOUT_NAME' not found under $layouts_dir"
  fi

  candidate="$target_dir/$DEFAULT_YAML_LAYOUT_FILE"
  if [[ -f "$candidate" ]]; then
    canonical_file "$candidate"
    return
  fi

  candidate="$target_dir/$DEFAULT_YAML_LAYOUT_FILE_ALT"
  if [[ -f "$candidate" ]]; then
    canonical_file "$candidate"
    return
  fi

  printf '\n'
}

create_session_from_default_windows() {
  local session_name="$1"
  local target_dir="$2"
  local -a window_names=("${DEFAULT_WINDOW_NAMES[@]}")
  local i

  tmux new-session -d -s "$session_name" -n "${window_names[0]}" -c "$target_dir"

  for ((i = 1; i < ${#window_names[@]}; i++)); do
    tmux new-window -t "$session_name:" -n "${window_names[$i]}" -c "$target_dir"
  done

  tmux select-window -t "$session_name:1"
}

yaml_session_name_override() {
  local layout_file="$1"
  local value

  value="$(yq e -r '.session.name // ""' "$layout_file")"
  value="$(trim "$value")"

  if [[ -z "$value" ]]; then
    printf '\n'
    return
  fi

  value="$(normalize_name "$value")"
  if [[ -z "$value" ]]; then
    fail "invalid session.name in $layout_file"
  fi

  printf '%s\n' "$value"
}

yaml_session_target_dir() {
  local layout_file="$1"
  local value
  local target_dir

  value="$(yq e -r '.session.dir // ""' "$layout_file")"
  value="$(trim "$value")"

  if [[ -z "$value" ]]; then
    printf '\n'
    return
  fi

  target_dir="$(resolve_target "$value")"
  if [[ ! -d "$target_dir" ]]; then
    fail "session.dir directory not found: $target_dir"
  fi

  printf '%s\n' "$(cd "$target_dir" && pwd -P)"
}

create_session_from_yaml_layout() {
  local session_name="$1"
  local target_dir="$2"
  local layout_file="$3"
  local window_index=1
  local window_count
  local pane_count
  local i
  local j
  local name
  local raw_dir
  local resolved_dir
  local command
  local pane_command
  local pane_split

  window_count="$(yq e '(.windows // []) | length' "$layout_file")"
  for ((i = 0; i < window_count; i++)); do
    name="$(yq e -r ".windows[$i].name // \"\"" "$layout_file")"
    name="$(trim "$name")"
    if [[ -z "$name" ]]; then
      fail "missing windows[$i].name in $layout_file"
    fi

    raw_dir="$(yq e -r ".windows[$i].dir // \".\"" "$layout_file")"
    raw_dir="$(trim "$raw_dir")"
    resolved_dir="$(resolve_layout_dir "$target_dir" "$raw_dir")"

    command="$(yq e -r ".windows[$i].command // \"\"" "$layout_file")"
    command="$(trim "$command")"

    if [[ $i -eq 0 ]]; then
      tmux new-session -d -s "$session_name" -n "$name" -c "$resolved_dir"
    else
      tmux new-window -t "$session_name:" -n "$name" -c "$resolved_dir"
    fi

    run_window_command "$session_name:$window_index" "$command"

    pane_count="$(yq e "(.windows[$i].panes // []) | length" "$layout_file")"
    if ! [[ "$pane_count" =~ ^[0-9]+$ ]]; then
      pane_count=0
    fi

    for ((j = 0; j < pane_count; j++)); do
      pane_command="$(yq e -r ".windows[$i].panes[$j].command // \"\"" "$layout_file")"
      pane_command="$(trim "$pane_command")"
      pane_split="$(yq e -r ".windows[$i].panes[$j].split // \"h\"" "$layout_file")"
      run_split_pane "$session_name:$window_index" "$resolved_dir" "$pane_split" "$pane_command"
    done

    window_index=$((window_index + 1))
  done

  tmux select-window -t "$session_name:1"
}

session_name_for_target() {
  local target_dir="$1"
  local source_name
  local session_name

  if [[ "$target_dir" == "$DEFAULT_PROJECT_ROOT/"* ]]; then
    source_name="${target_dir#"$DEFAULT_PROJECT_ROOT/"}"
  else
    source_name="$target_dir"
  fi

  session_name="$(normalize_name "$source_name")"
  if [[ -z "$session_name" ]]; then
    session_name="project"
  fi

  printf '%s\n' "$session_name"
}

parse_args "$@"

if ! command -v tmux >/dev/null 2>&1; then
  fail "tmux is not installed or not on PATH"
fi

if [[ "$SESSION_MODE" -eq 1 ]]; then
  if [[ -z "$SESSION_NAME_ARG" ]]; then
    if [[ ! -t 0 || ! -t 1 ]]; then
      fail "--session requires a session name when not running interactively"
    fi

    if ! command -v fzf >/dev/null 2>&1; then
      fail "fzf is required for interactive session selection"
    fi

    SESSION_NAME_ARG="$(select_session_with_fzf)"
    if [[ -z "$SESSION_NAME_ARG" ]]; then
      exit 0
    fi
  fi

  switch_to_session "$SESSION_NAME_ARG"
fi

if [[ "$TARGET_PROVIDED" -eq 0 && -z "$LAYOUT_NAME" && -z "$LAYOUT_FILE_ARG" && -t 0 && -t 1 ]]; then
  if ! command -v fzf >/dev/null 2>&1; then
    fail "fzf is required when no target is provided"
  fi
  selected="$(select_with_fzf)"
  [[ -n "$selected" ]] || exit 0
  case "$selected" in
    "[session] "*) switch_to_session "${selected#"[session] "}" ;;
    "[project] "*) set_target "${selected#"[project] "}" ;;
    *) fail "invalid picker selection: $selected" ;;
  esac
fi

target="$(resolve_target "$TARGET_ARG")"
if [[ ! -d "$target" ]]; then
  fail "project directory not found: $target"
fi

target="$(cd "$target" && pwd -P)"

yaml_layout_file="$(resolve_yaml_layout_file "$target")"
if [[ -n "$yaml_layout_file" ]]; then
  validate_layout "$yaml_layout_file"
fi

if [[ -n "$yaml_layout_file" && "$TARGET_PROVIDED" -eq 0 ]]; then
  session_target="$(yaml_session_target_dir "$yaml_layout_file")"
  if [[ -n "$session_target" ]]; then
    target="$session_target"
  fi
fi

session_name="$(session_name_for_target "$target")"

if [[ -n "$yaml_layout_file" ]]; then
  session_override="$(yaml_session_name_override "$yaml_layout_file")"
  if [[ -n "$session_override" ]]; then
    session_name="$session_override"
  fi
fi

if ! tmux has-session -t "$session_name" 2>/dev/null; then
  if [[ -n "$yaml_layout_file" ]]; then
    create_session_from_yaml_layout "$session_name" "$target" "$yaml_layout_file"
  else
    create_session_from_default_windows "$session_name" "$target"
  fi
fi

if [[ -n "${TMUX:-}" ]]; then
  exec tmux switch-client -t "$session_name"
fi

exec tmux attach-session -t "$session_name"
